{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "trycopilotai",
  "description": "Agent skills maintained by trycopilot.ai.",
  "version": "0.5.1",
  "owner": {
    "name": "Pramod Kotipalli",
    "url": "https://github.com/trycopilotai"
  },
  "plugins": [
    {
      "name": "htmlify",
      "displayName": "htmlify",
      "source": "./plugins/htmlify",
      "description": "Turn dense Markdown into source-checked HTML timelines, decision surfaces, system explainers, visual progressions, evidence reviews, or deterministic formal HTML with optional PDF export.",
      "version": "0.2.3",
      "author": {
        "name": "Pramod Kotipalli"
      },
      "homepage": "https://github.com/trycopilotai/htmlify",
      "repository": "https://github.com/trycopilotai/htmlify",
      "license": "MIT",
      "category": "visualization",
      "tags": [
        "markdown",
        "visualization",
        "html",
        "pdf",
        "decision-surface"
      ]
    },
    {
      "name": "replx",
      "displayName": "replx",
      "source": "./plugins/replx",
      "description": "Drive a failing build, test, lint, or health check to a success condition you declare, in bounded iterations. The condition can be stated in prose, so a goal the command does not measure is still a valid target, and the protocol refuses the repairs that make a command pass without fixing the defect.",
      "version": "0.2.0",
      "author": {
        "name": "Pramod Kotipalli"
      },
      "homepage": "https://github.com/trycopilotai/replx",
      "repository": "https://github.com/trycopilotai/replx",
      "license": "MIT",
      "category": "repair",
      "tags": [
        "repair-loop",
        "ralph-wiggum",
        "program-repair",
        "benchmark",
        "reward-hacking"
      ]
    },
    {
      "name": "lint",
      "displayName": "lint",
      "source": "./plugins/lint",
      "description": "Check or apply canonical formatting across mixed-language repositories with a read-only default.",
      "version": "0.1.6",
      "author": {
        "name": "Pramod Kotipalli"
      },
      "homepage": "https://github.com/trycopilotai/lint",
      "repository": "https://github.com/trycopilotai/lint",
      "license": "MIT",
      "category": "formatting",
      "tags": [
        "lint",
        "formatting",
        "docker",
        "developer-tools"
      ]
    }
  ]
}
